[Desktop Entry]
Type=Application
Name=Fracker
Comment=Warframe session planner (resident tray)
Exec=fracker
Icon=io.github.sethkinast.Fracker
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
# Fracker autostart entry (seventh pass §5).
#
# KDE Plasma / XDG autostart picks up .desktop files from
# ~/.config/autostart/. Install this file there so the resident tray
# starts with the desktop session:
#
#   unsandboxed:  install -Dm644 flatpak/io.github.sethkinast.Fracker.autostart.desktop \
#                   ~/.config/autostart/io.github.sethkinast.Fracker.desktop
#   Flatpak:      System Settings -> Autostart -> Add -> Application -> Fracker
#                 (adds the exported io.github.sethkinast.Fracker launcher,
#                  whose Exec Flatpak manages for you)
#
# The resident is single-instance (flock), so an extra manual launch just
# exits; a second autostart entry can never double-watch the EE.log.
